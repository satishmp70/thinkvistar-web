# =========================================================================
# THINKVISTAR ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================================
# Copy this file to .env and configure your real secrets.
#
#   cp .env.example .env
#
# Put the real file OUTSIDE the web root, in your hosting home directory:
#   /home/uXXXX/.env        <- recommended (public_html is /home/uXXXX/public_html)
# Fallbacks (inside the web root, less safe; .htaccess blocks them): public_html/.env, public_html/api/.env
#
# IMPORTANT: .env contains sensitive credentials and must NEVER be committed to Git.
# =========================================================================

# Delivery transport: 'smtp' (PHPMailer) or 'mail' (PHP mail() function)
MAIL_TRANSPORT=smtp

# Where contact form enquiries are delivered
MAIL_RECIPIENT=hello@thinkvistar.com
MAIL_RECIPIENT_NAME="Thinkvistar LLP"

# Notification email subject line
MAIL_SUBJECT="New Contact Form Enquiry"

# Timezone used for timestamps in enquiry emails
MAIL_TIMEZONE=Asia/Kolkata

# Sender address (must match your domain or SMTP provider)
MAIL_FROM_EMAIL=hello@vistarsolution.com
MAIL_FROM_NAME="Thinkvistar Website"

# SMTP Server Settings (Hostinger / cPanel / Gmail)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=hello@vistarsolution.com
SMTP_PASSWORD=your_mailbox_password_here

# Optional: Rate limiting (maximum submissions per visitor per hour)
MAIL_MAX_PER_HOUR=5

# Optional: complete origins (scheme + host [+ port]) allowed to post the form, compared exactly.
# Defaults to https://thinkvistar.com and https://www.thinkvistar.com. Setting this REPLACES the
# defaults, so list production too. Add a staging or local origin only when you need one:
# ALLOWED_ORIGINS=https://thinkvistar.com,https://www.thinkvistar.com,https://staging.thinkvistar.com

# Optional: use X-Forwarded-For for the rate limit. Leave false unless your host's
# proxy/CDN overwrites that header (if it is true on an open server, bots can spoof it).
# If every visitor shows the proxy's address and gets blocked after 5 enquiries, set true.
# TRUST_PROXY_HEADERS=false

# Optional: private folder for the rate-limit counters (must be writable, not web-served).
# Default: .thinkvistar-ratelimit in the hosting home directory, else the system temp folder.
# If no folder is writable the form refuses submissions (HTTP 503) instead of running unlimited.
# RATE_LIMIT_DIR=/home/uXXXX/.thinkvistar-ratelimit

# TEST ONLY: MAIL_TRANSPORT=file with MAIL_FILE_PATH records messages as JSON instead of sending.
# Never set these on the live site.
# MAIL_FILE_PATH=/tmp/thinkvistar-mail.jsonl
