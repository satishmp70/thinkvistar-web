# =========================================================================
# THINKVISTAR ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================================
# Copy this file to .env and configure your real secrets.
#
#   cp .env.example .env
#
# Supported locations for .env:
#   - Project root: /.env
#   - API folder:   /api/.env
#
# IMPORTANT: .env contains sensitive credentials and must NEVER be committed to Git.
# Both root and api/.htaccess block public HTTP access to .env files.
# =========================================================================

# Delivery transport: 'smtp' (PHPMailer) or 'mail' (PHP mail() function)
MAIL_TRANSPORT=smtp

# Where contact form enquiries are delivered
MAIL_RECIPIENT=hello@thinkvistar.com
MAIL_RECIPIENT_NAME="Thinkvistar LLP"

# Notification email subject line
MAIL_SUBJECT="New Contact Form Enquiry"

# Timezone used for timestamps in enquiry emails
MAIL_TIMEZONE=Asia/Kolkata

# Sender address (must match your domain or SMTP provider)
MAIL_FROM_EMAIL=hello@vistarsolution.com
MAIL_FROM_NAME="Thinkvistar Website"

# SMTP Server Settings (Hostinger / cPanel / Gmail)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=hello@vistarsolution.com
SMTP_PASSWORD=your_mailbox_password_here

# Optional: Rate limiting (maximum submissions per visitor per hour)
MAIL_MAX_PER_HOUR=5

# Optional: Comma-separated allowed origins (leave empty for same-origin only)
# ALLOWED_ORIGINS=https://thinkvistar.com,https://www.thinkvistar.com
