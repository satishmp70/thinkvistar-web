{
  "name": "thinkvistar-site-build",
  "private": true,
  "type": "module",
  "description": "Builds the static Thinkvistar website into the repository root.",
  "scripts": {
    "build": "node build.mjs",
    "build:fast": "node build.mjs --no-prerender",
    "verify": "node verify.mjs",
    "check": "node check.mjs",
    "test:browser": "node test-browser.mjs",
    "test:contact": "node test-contact.mjs",
    "test:indexnow": "node test-indexnow.mjs",
    "test:lastmod": "node test-lastmod.mjs",
    "lighthouse": "node lighthouse-check.mjs",
    "audit:deps": "npm audit --audit-level=high",
    "test": "npm run verify && npm run check && npm run test:browser && npm run test:contact && npm run test:indexnow",
    "preview": "node preview.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "puppeteer-core": "^25.15.0"
  }
}
